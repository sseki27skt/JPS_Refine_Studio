# =============================================================================
# JPS Refine Studio - Git Ignore Configuration
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
.npm/

# Streamlit logs & cache
01_cleansing_studio/logs/*.log
logs/*.log
*.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE / Editor files
.idea/
.vscode/
*.swp
*.swo

# Environment Variables & Secrets
.env
.env.*
*.env

# =============================================================================
# Large Metadata & Database Files (ジャパンサーチ取得データ・バイナリの完全除外)
# =============================================================================
*.jsonl
*.jsonl.*
*.duckdb
*.duckdb.wal
scores.jsonl

# Pipeline temporary outputs & intermediate datasets
data/*.csv
data/discarded_*.csv
data/benchmark_llm_200/
data/benchmark_tmp/
data/fetch_job_status.json
data/fetch_job_status.json.tmp
data/workspaces/
archive/data/

# Whitelist: システム稼働に必要な軽量APIキャッシュ・辞書のみ許可
!data/ndc_api_cache.json
!data/ndlna_api_cache.json
!data/ndlc_api_cache.json

# Documentation
!docs/
